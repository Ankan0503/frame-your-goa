{
  "version": 2,
  "functions": {
    "server.ts": {
      "runtime": "@vercel/node",
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/server.ts"
    },
    {
      "source": "/share/:path*",
      "destination": "/server.ts"
    }
  ]
}
